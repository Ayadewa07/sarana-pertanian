{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "admin/api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
